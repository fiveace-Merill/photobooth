# Copy to .env and change the passwords. Never commit .env.

# Postgres container. POSTGRES_USER owns the tables and runs migrations.
POSTGRES_USER=photobooth_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=photobooth

# Password for the non-owner role the API connects as (created by db/init/01_roles.sh).
APP_DB_PASSWORD=change-me-app

# Used by goose (owner).
MIGRATE_DATABASE_URL=postgres://photobooth_owner:change-me-owner@localhost:5432/photobooth?sslmode=disable

# Used by the API (non-owner, subject to row-level security).
DATABASE_URL=postgres://photobooth_app:change-me-app@localhost:5432/photobooth?sslmode=disable

# Session cookie. Set to false for plain HTTP local development; keep true in production.
COOKIE_SECURE=true

# Public self-signup: closed | invite | open. Default is invite.
# Open self-signup is refused at startup when APP_ENV=production.
SIGNUP_MODE=invite

# Next.js dev proxy target for /api/v1 and /healthz.
API_ORIGIN=http://localhost:8080

# Environment: development, test, staging, production. Seed refuses production.
APP_ENV=development

# Cloudflare R2 / photo storage (S3-compatible). Required for photo uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the app (used in links/metadata; no trailing slash).
PUBLIC_URL=http://localhost:3000

# Photo limits
MAX_PHOTO_BYTES=62914560
MAX_PHOTOS_PER_SHOOT=500
MAX_IMAGE_MEGAPIXELS=100
RIVER_MAX_WORKERS=2
# Non-production only: slow down process_photo to test kill/recovery. Ignored in production.
PHOTO_TEST_DELAY=0s

# Email delivery (slice 4). Never log secrets or delivery URLs/tokens.
# log: local/dev only, prints to logs (URL only in development). Refused in production.
# smtp: send via SMTP server.
EMAIL_PROVIDER=log
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=none
MAIL_FROM_ADDRESS=no-reply@photobooth.local
MAIL_FROM_NAME=Photobooth
EMAIL_DAILY_LIMIT_PER_PHOTOGRAPHER=50

# Admin (platform operator)
ADMIN_REQUIRE_2FA=true
# 32-byte hex key for encrypting TOTP secrets at rest. Generate: openssl rand -hex 32
ADMIN_TOTP_ENC_KEY= # required: openssl rand -hex 32
# Optional comma-separated IPs/CIDRs allowed to access admin routes. Empty = no restriction.
ADMIN_ALLOWED_IPS=
ADMIN_SESSION_IDLE_MINUTES=60
ADMIN_SESSION_MAX_HOURS=12
# Comma-separated CIDRs/IPs of trusted reverse proxies. Default empty = use RemoteAddr only.
# Only set when API is behind a trusted proxy that overwrites X-Forwarded-For (see docs/operations.md).
TRUSTED_PROXY_CIDRS=
